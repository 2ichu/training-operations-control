# PostgreSQL 연결 (필수). 실제 값은 .env 에 두고 커밋하지 않는다.
# 형식: postgres://<계정>:<비밀번호>@<호스트>:<포트>/<DB명>
DATABASE_URL=postgres://training_owner:change-me@localhost:5432/training_mgmt

# 커넥션 풀 최대 크기 (선택, 기본 10)
DB_POOL_MAX=10

# 최초 SYS_ADMIN 시드 (npm run db:seed 에서만 사용, 모두 필수, 기본 비밀번호 없음)
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# 세션·로그인 정책 임시값 (STEP 12 #29 확정 전, 모두 선택)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# SESSION_COOKIE_NAME=sid
# SESSION_COOKIE_SECURE=true   # 기본: NODE_ENV=production 일 때 true

# 일정의 계산값 "진행완료" 판정 시간대 (STEP 12 미확정, 선택, 기본 Asia/Seoul)
# APP_TIMEZONE=Asia/Seoul

# 시간 기반 배치(과정 자동 운영중 전환, RULE_01~06)와 입실 확인 후 RULE_01·02 비동기 평가 (선택, 기본 true — NODE_ENV=test 에서만 false)
# 인스턴스를 여러 대 띄우면 한 대만 true 로 둔다(decisions.md 11절 P5-07)
# BATCH_ENABLED=true

# 리버스 프록시 뒤에서 실제 접속 IP 를 쓰려면 믿을 프록시 단계 수(예: 1) — 비우면 직접 접속 IP (선택)
# TRUST_PROXY=1

# 첨부 저장 경로(선택, 기본 ./uploads)·서버 포트(선택, 기본 3000)
# UPLOAD_DIR=./uploads
# PORT=3000
