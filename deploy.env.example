# compose.yaml 이 읽는 배포 설정. 이 파일을 deploy.env 로 복사해 값을 채운다(deploy.env 는 커밋하지 않는다).
# 각 항목의 의미·기본값은 docs/DEPLOY.md "환경변수" 표 참고.

# ── DB (필수) ──
POSTGRES_DB=training_mgmt
POSTGRES_USER=training_owner
POSTGRES_PASSWORD=

# ── 최초 시스템 관리자 (필수 — 배포마다 시드가 확인한다. 이미 있으면 건너뛰고 비밀번호도 덮어쓰지 않음) ──
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=시스템 관리자

# ── 웹 포트 (선택, 기본 8080) ──
# WEB_PORT=8080

# ── 세션 쿠키 (선택) ──
# NODE_ENV=production 이면 기본 Secure 쿠키 — HTTPS 로만 로그인된다(앞단에서 TLS 종료 전제).
# TLS 없이 내부망 http 로 시험할 때만 false 로 둔다.
# SESSION_COOKIE_SECURE=true
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=8
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# ── 기타 (선택) ──
# APP_TIMEZONE=Asia/Seoul
# BATCH_ENABLED=true     # backend 를 여러 대 띄우면 한 대만 true
# DB_POOL_MAX=10
